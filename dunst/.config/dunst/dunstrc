# dunst — notifications for i3, One Dark (matches rofi/i3)
[global]
    monitor = 0
    follow = mouse
    origin = top-right
    offset = 12x40
    width = (280, 380)
    height = 160
    notification_limit = 5
    gap_size = 6
    padding = 12
    horizontal_padding = 14
    frame_width = 2
    corner_radius = 8
    separator_height = 2
    separator_color = frame
    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    ellipsize = end
    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    show_age_threshold = 60
    # Keep a long history for the notification center (Win+N)
    history_length = 100
    sticky_history = yes
    idle_threshold = 120
    dmenu = rofi -dmenu -p dunst
    browser = xdg-open
    mouse_left_click = do_action, close_current
    mouse_middle_click = close_all
    mouse_right_click = close_current

[urgency_low]
    background = "#1E2127"
    foreground = "#ABB2BF"
    frame_color = "#3E4451"
    timeout = 5

[urgency_normal]
    background = "#1E2127"
    foreground = "#FFFFFF"
    frame_color = "#61AFEF"
    timeout = 8

[urgency_critical]
    background = "#1E2127"
    foreground = "#FFFFFF"
    frame_color = "#E06C75"
    timeout = 0
